#include <iostream>
using namespace std;
int main(){
    int a;
    int b;
    char op;
    cout<<"enter first number";
    cin>>a;
    cout<<"enter second number";
    cin>>b;
    cout<<"enter an operator";
    cin>>op;
    if(op =='+')
    {
        cout<<a+b;
    }
    else if(op =='-')
    {
        cout<<"a-b";
    }
    else if(op =='*')
    {
        cout<< a*b;
    }
    else if(op =='/')
    {
        cout<<a/b;
    }
    else
    {
        cout<<"Invalid op";
    }
    
    return 0;
}
    
